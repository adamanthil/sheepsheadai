{
  "name": "sheepshead-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "openapi-typescript openapi.json -o lib/api.gen.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.8.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.3",
    "js-yaml": "^4.3.0"
  }
}
