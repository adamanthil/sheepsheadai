# API origin, inlined at BUILD time (next build), not runtime.
# Leave empty for same-origin (production behind the reverse proxy).
# Unset in dev: falls back to http://<current-hostname>:9000.
NEXT_PUBLIC_API_BASE=

# Comma-separated hostnames (no scheme, no port) allowed to reach dev-server
# internals. Next trusts localhost only, so the HMR websocket 403s when a phone
# loads the app over the LAN -- the page renders but Fast Refresh dies. Set this
# alongside SHEEPSHEAD_CORS_ORIGINS in the repo-root .env when testing on a
# device, e.g. DEV_ALLOWED_ORIGINS=andrews-macbook-pro.local
# Dev-server-only: no effect on `next build` or production.
DEV_ALLOWED_ORIGINS=
