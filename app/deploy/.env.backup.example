# Copy to app/deploy/.env.backup (gitignored) and fill in; read by
# app/scripts/offsite_backup.sh and restore_drill.sh. Passed to docker
# --env-file, so no quotes around values.
#
# rclone remotes, defined by environment instead of a config file:
# `b2` is the bucket's account, `crypt` encrypts names and contents over it.
RCLONE_CONFIG_B2_TYPE=b2
# The application key restricted to the backup bucket (keyID, then key).
RCLONE_CONFIG_B2_ACCOUNT=0000000000000000000000000
RCLONE_CONFIG_B2_KEY=K000change-me
RCLONE_CONFIG_CRYPT_TYPE=crypt
RCLONE_CONFIG_CRYPT_REMOTE=b2:sheepshead-backups
# Both from `docker run --rm rclone/rclone:1.75.2 obscure '<passphrase>'`
# with two different long random passphrases. Losing these makes every
# backup unreadable: keep the passphrases offline with .env.prod's copy.
RCLONE_CONFIG_CRYPT_PASSWORD=change-me
RCLONE_CONFIG_CRYPT_PASSWORD2=change-me
# The healthchecks.io check's ping URL (period 1 day, grace 2 hours).
BACKUP_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
