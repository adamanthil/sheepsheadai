# Copy to app/deploy/.env.prod (gitignored) and fill in. Human-owned secrets
# only: the model, its sampling and the image tags are written to
# app/deploy/.env.deploy by app/scripts/deploy.sh from models/manifest.json.
DOMAIN=sheepshead.example.com
POSTGRES_USER=sheepshead
POSTGRES_PASSWORD=change-me-to-something-long-and-random
# Resend API key and a sender on a domain verified with Resend (SPF/DKIM).
RESEND_API_KEY=re_change_me
EMAIL_FROM=Sheepshead AI <noreply@sheepshead.example.com>
