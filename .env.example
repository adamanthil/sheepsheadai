# The released model: the artifact with role "deploy" in models/manifest.json
# (uv run python -m sheepshead.eval.fetch_models --role deploy).
SHEEPSHEAD_MODEL_PATH=./models/sheepsheadai-1.0-202610.pt
# Human-readable label for the loaded model; production uses the manifest key.
# Must be set; server refuses to boot without it.
SHEEPSHEAD_MODEL_LABEL=sheepsheadai-1.0-202610
# Sampling for the table AI: per-head softmax temperatures (0 = argmax) and a
# logit band in nats. These are the release's values from the manifest; they
# are tuned per checkpoint, so change them together with the model.
SHEEPSHEAD_TEMPERATURE_PICK=0.5
SHEEPSHEAD_TEMPERATURE_PARTNER=0.5
SHEEPSHEAD_TEMPERATURE_BURY=0.0
SHEEPSHEAD_TEMPERATURE_PLAY=0.5
SHEEPSHEAD_LOGIT_BAND=1.0
# Origins we explicitly trust. In production this is the entire CORS allowlist
# and the server refuses to boot without it. In development it is *additive* on
# top of the built-in localhost/127.0.0.1 allowance, so leaving it empty keeps
# the default localhost-only posture. To test from a phone on the LAN, add the
# origin the phone actually uses (scheme + host + port), e.g.
#   SHEEPSHEAD_CORS_ORIGINS=http://andrews-macbook-pro.local:3000
# and set DEV_ALLOWED_ORIGINS in app/web/.env.local so HMR keeps working.
SHEEPSHEAD_CORS_ORIGINS=http://localhost:3000
ENV=development
LOG_FORMAT=text

# Account emails (verification, password reset) are sent through Resend.
# Leave the key empty in development: emails and their links are logged
# instead. PUBLIC_BASE_URL is the web app origin the links point at.
RESEND_API_KEY=
EMAIL_FROM="Sheepshead AI <noreply@localhost>"
PUBLIC_BASE_URL=http://localhost:3000

# Postgres connection used by the server at runtime.
DATABASE_URL=postgres://sheepshead:sheepshead@localhost:5433/sheepshead

# Used by graphile-migrate (dev/CI only — never set these in production).
SHADOW_DATABASE_URL=postgres://sheepshead:sheepshead@localhost:5433/sheepshead_shadow
ROOT_DATABASE_URL=postgres://sheepshead:sheepshead@localhost:5433/postgres

# Bind address for the dev server (production sets these in the container).
# Note run_server.sh defaults to 0.0.0.0; setting HOST here to 127.0.0.1 makes
# the API loopback-only, which blocks LAN/mobile testing regardless of CORS.
HOST=127.0.0.1
PORT=9000
